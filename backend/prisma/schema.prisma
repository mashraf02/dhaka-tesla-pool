generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
}

enum Area {
  BANANI
  GULSHAN
  MOHAKHALI
  DHANMONDI
  MIRPUR
  UTTARA
  FARMGATE
  BASHUNDHARA
}

enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  createdAt    DateTime      @default(now())
  vehicles     Vehicle[]
  rideRequests RideRequest[]

  @@index([email])
}

model Vehicle {
  id        String   @id @default(uuid())
  label     String
  capacity  Int
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())

  driverId String
  driver   User   @relation(fields: [driverId], references: [id])

  pools Pool[]

  @@index([driverId])
}

model Pool {
  id          String     @id @default(uuid())
  status      RideStatus @default(REQUESTED)
  seatsUsed   Int        @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  rideRequests RideRequest[]

  @@index([vehicleId])
}

model RideRequest {
  id                  String     @id @default(uuid())
  pickupArea          Area
  destinationArea     Area
  seatsRequested      Int        @default(1)
  status              RideStatus @default(REQUESTED)
  estimatedFarePoysha Int
  finalFarePoysha     Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  passengerId String
  passenger   User   @relation(fields: [passengerId], references: [id])

  poolId String?
  pool   Pool?   @relation(fields: [poolId], references: [id])

  statusHistory RideStatusEvent[]

  @@index([passengerId])
  @@index([poolId])
  @@index([status])
}

model RideStatusEvent {
  id         String      @id @default(uuid())
  fromStatus RideStatus?
  toStatus   RideStatus
  note       String?
  changedAt  DateTime    @default(now())

  rideRequestId String
  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id])

  @@index([rideRequestId])
}